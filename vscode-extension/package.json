{
  "name": "graphviewer-gp",
  "displayName": "graphviewer-gp",
  "description": "Viewer ao vivo de execuções LangGraph, direto no VS Code",
  "version": "0.0.1",
  "publisher": "gabrielpl-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabrielpl-dev/graphviewer-gp.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphviewerGp.openGraph",
        "title": "graphviewer-gp: Abrir grafo"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "graphviewerGp.openGraph",
          "when": "resourceFilename == langgraph.json",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphviewerGp",
          "title": "graphviewer-gp",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "graphviewerGp": [
        {
          "id": "graphviewerGp.graphView",
          "name": "Grafo",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
